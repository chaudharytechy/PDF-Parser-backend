# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string-replace cache
.grunt

# Bower dependency directory (if using legacy bower)
bower_components

# node-modules folder (never commit this)
node_modules/
jspm_packages/
web_modules/

# Optional npm cache directory
.npm

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files (contains sensitive API keys and secrets)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Serverless Webpack directories
.webpack/

# Bundler caches
.cache/
.parcel-cache
.eslintcache
.stylelintcache

# Next.js build output
.next/
out/

# Nuxt.js build output
.nuxt/
dist/
.output/

# TypeScript cache
*.tsbuildinfo

# Optional IDEs and text editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system files
.DS_Store
Thumbs.db
